{
  "name": "dsh-vn-plugins",
  "version": "0.1.0-alpha.0",
  "private": true,
  "description": "Personal plugin pack for DeepSeek Harness (Windows). Installs into the raw CLI profile (npx @deepseek-ai/dsh web) and dsh-desktop.",
  "license": "MIT",
  "scripts": {
    "install:cli": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/install-all.ps1 -Target cli",
    "install:desktop": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/install-all.ps1 -Target desktop",
    "install:all": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/install-all.ps1 -Target all",
    "uninstall": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/uninstall-all.ps1"
  },
  "engines": {
    "node": ">=22"
  }
}
